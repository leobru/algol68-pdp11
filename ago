#!/usr/bin/env python3
"""Execute an original a68.out through the original runtime loader."""
import os
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parent
if len(sys.argv) != 1:
    sys.exit('usage: ago (runs a68.out in the current directory)')
if not (root / 'build/ready.json').is_file():
    subprocess.run([sys.executable, str(root / 'scripts/build.py')], check=True)
if not Path('a68.out').is_file():
    sys.exit('ago: a68.out is missing; compile a program with alg first')
env = dict(os.environ, APOUT_ROOT=str(root / 'build/root'), APOUT_UNIX_VERSION='V7')
process = subprocess.Popen([str(root / 'build/apout'), str(root / 'build/ago')],
                           env=env, stdout=subprocess.PIPE)
tail = b''
while True:
    chunk = os.read(process.stdout.fileno(), 8192)
    if not chunk:
        break
    sys.stdout.buffer.write(chunk)
    sys.stdout.buffer.flush()
    tail = (tail + chunk)[-256:]
status = process.wait()
# The original RTE leaves r0 unspecified on normal exit. Require its completion
# message, while retaining runtime/emulator failures as a failed invocation.
completed = tail.rstrip().endswith(b'ALGOL68: END OF EXECUTION.')
sys.exit(0 if status >= 0 and completed else (status if status > 0 else 1))
