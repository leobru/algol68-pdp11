+void guest_rti(void)
+{
+    unsigned short pc, ps;
+    ll_word(regs[SP], pc);
+    regs[SP] += 2;
+    ll_word(regs[SP], ps);
+    regs[SP] += 2;
+    regs[PC] = pc;
+    CC_N = !!(ps & 010); CC_Z = !!(ps & 04);
+    CC_V = !!(ps & 02); CC_C = !!(ps & 01);
+}
+
 void emt()
 {
+    if (guest_emt_handler > 1) {
+        unsigned short handler = guest_emt_handler;
+        unsigned short ps = (CC_N << 3) | (CC_Z << 2) | (CC_V << 1) | CC_C;
+        guest_emt_handler = 0; /* V7 signals are reset on delivery. */
+        regs[SP] -= 2;
+        sl_word(regs[SP], ps);
+        regs[SP] -= 2;
+        sl_word(regs[SP], regs[PC]);
+        regs[PC] = handler;
+        return;
+    }
+    if (guest_emt_handler == 1) return;
+
     TrapDebug((stderr, "Apout - pid %d emt instruction at PC 0%o\n",
                (int) getpid(), regs[PC]));
     exit(EXIT_FAILURE);
